# Secrets OmniRoute. Copier en infra/omniroute/.env (ignoré par git) et remplir.
# Variables issues du .env.example officiel d'OmniRoute (v3.8.50).

# Signature des sessions du tableau de bord — générer : openssl rand -base64 48
JWT_SECRET=
# Signature des clés d'API émises par OmniRoute — générer : openssl rand -hex 32
API_KEY_SECRET=
# Chiffrement des clés fournisseurs stockées en base — générer : openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
# Mot de passe initial du tableau de bord : le changer (défaut officiel CHANGEME).
INITIAL_PASSWORD=change-me

# Exige une clé d'API sur le proxy /v1 (par défaut officiel : false = anonyme).
REQUIRE_API_KEY=true

# Synchro cloud désactivée (laisser vide).
CLOUD_URL=
