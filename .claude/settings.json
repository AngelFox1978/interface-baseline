{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node *)",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "PowerShell(npm run *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -a)"
    ]
  },
  "$comment": "Socle générique et sûr pour tout projet issu du template : scripts npm, node, édition, lecture git. Push, reset, restore et toute écriture git restent soumis à confirmation."
}
