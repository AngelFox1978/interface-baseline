# Port de l'interface (Pilot l'injecte à la création). Next lit la variable PORT.
PORT=3000

# Secret de signature de session (généré par post-init.sh). NE PAS committer .env
AUTH_SECRET=change-me-generate-a-long-random-string

# Compte admin de CETTE interface (un par interface).
# ADMIN_PASSWORD_HASH = bcrypt du mot de passe, généré par `npm run seed:admin`.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD_HASH=

# Postgres (optionnel) — tables prompts et audit_log (pages Prompts et Journal).
# Sans base, ces pages affichent un message "base injoignable" ; le reste fonctionne.
# Exemple avec infra/postgres (mêmes identifiants que infra/postgres/.env) :
# DATABASE_URL=postgres://baseline:change-me@127.0.0.1:5432/baseline

# Ollama local (optionnel) — traduction des descriptions dans les Paramètres.
# OLLAMA_URL=http://localhost:11434

# Context7 (serveur MCP de doc, .mcp.json) — clé optionnelle, limites plus hautes.
# À définir dans l'environnement du shell qui lance claude (pas lu depuis .env).
# CONTEXT7_API_KEY=
